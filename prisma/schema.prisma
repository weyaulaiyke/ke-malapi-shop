generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model products {
  id           Int      @id @default(autoincrement())
  name         String   @db.VarChar(150)
  description  String?
  price        Decimal  @db.Decimal(12, 2)
  category     String   @db.VarChar(50)
  image_url    String?
  is_available Boolean  @default(true)
  is_featured  Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  sizes product_sizes[]
}

model product_sizes {
  id         Int       @id @default(autoincrement())
  product_id Int
  size       String    @db.VarChar(30)
  product    products  @relation(fields: [product_id], references: [id], onDelete: Cascade)
  bagItems   BagItem[]

  @@unique([product_id, size])
}

model Customer {
  id           Int       @id @default(autoincrement())
  name         String    @db.VarChar(150)
  email        String    @unique @db.VarChar(254)
  passwordHash String    @map("password_hash")
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  bagItems     BagItem[]

  @@map("customers")
}

model Seller {
  id           Int      @id @default(autoincrement())
  accountKey   String   @unique @default("owner") @map("account_key")
  email        String   @unique @db.VarChar(254)
  passwordHash String   @map("password_hash")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  @@map("sellers")
}

model BagItem {
  id            Int      @id @default(autoincrement())
  customerId    Int      @map("customer_id")
  productSizeId Int      @map("product_size_id")
  quantity      Int      @default(1)
  createdAt     DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  customer    Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  productSize product_sizes @relation(fields: [productSizeId], references: [id], onDelete: Cascade)

  @@unique([customerId, productSizeId])
  @@index([productSizeId])
  @@map("bag_items")
}

model user_sessions {
  sid    String   @id(map: "session_pkey") @db.VarChar
  sess   Json     @db.Json
  expire DateTime @db.Timestamp(6)

  @@index([expire], map: "IDX_session_expire")
}
