<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Ke. MALAPI | Handmade Crochet</title>

    <meta name="description" content="Discover handmade crochet clothing from Ke. MALAPI.">

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">

    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/" aria-label="Ke. MALAPI home">
                <img class="brand-logo" src="/images/logo.jpg" alt="Ke. MALAPI">
            </a>

            <nav class="main-nav" aria-label="Main navigation">
                <a href="<%= isCustomer ? '/shop' : '#collection' %>">Shop</a>
                <a href="#our-story">Our story</a>
                <a href="#lookbook">Lookbook</a>
                <a href="#contact">Contact</a>
            </nav>

            <% if (isSeller) { %>
                <a class="button button-dark header-shop" href="/seller">
          Seller dashboard
        </a>
                <% } else if (isCustomer) { %>
                    <div class="store-account">
                        <a href="/cart">Cart</a>

                        <a class="button button-dark header-shop" href="/shop">
            Shop collection
          </a>
                    </div>
                    <% } else { %>
                        <button class="button button-dark header-shop" id="open-account" type="button">
          Log in / Sign up
        </button>
                        <% } %>
        </div>
    </header>

    <main>
        <section class="hero">
            <div class="container hero-inner">
                <div class="hero-copy">
                    <p class="eyebrow">HANDMADE. INDIVIDUALLY YOU.</p>

                    <h1>Handmade crochet, as unique as you are.</h1>

                    <p class="hero-description">
                        Slow fashion, stitched with love. Each piece is crocheted by hand and made to be worn with pride.
                    </p>

                    <div class="hero-actions">
                        <a class="button button-dark" href="<%= isCustomer ? '/shop' : '#collection' %>">
              Explore the collection
            </a>

                        <a class="button button-outline" href="#our-story">
              Our story
            </a>
                    </div>
                </div>

                <div class="hero-visual" aria-hidden="true">
                    <div class="hero-image hero-image-tan"></div>
                    <div class="hero-image hero-image-brown"></div>
                </div>
            </div>
        </section>

        <div class="brand-strip">
            <div class="container brand-strip-inner">
                <span>Made by hand</span>
                <span>Made to be worn with pride</span>
                <span>Ke. MALAPI</span>
            </div>
        </div>

        <section id="our-story" class="story-section">
            <div class="container story-inner">
                <div class="story-copy">
                    <p class="eyebrow">THE ART OF TAKING IT SLOW</p>

                    <h2>Slow fashion, stitch by stitch.</h2>

                    <p>
                        Handmade crochet clothing with care in every detail. Discover pieces that bring a personal touch to your everyday wardrobe.
                    </p>

                    <a class="text-link" href="<%= isCustomer ? '/shop' : '#collection' %>">
            Find your next piece &rarr;
          </a>
                </div>

                <div class="story-image" aria-hidden="true"></div>
            </div>
        </section>

        <section class="categories-section" aria-labelledby="categories-title">
            <div class="container">
                <h2 id="categories-title">What we make</h2>

                <div class="category-grid">
                    <% const categories = [
            { name: 'Tops', colour: 'category-tan' },
            { name: 'Dresses', colour: 'category-sand' },
            { name: 'Bottoms', colour: 'category-tan' },
            { name: 'Accessories', colour: 'category-sand' }
          ]; %>

                        <% categories.forEach((category) => { %>
                            <a class="category-card" href="<%= isCustomer ? '/shop' : '#collection' %>">
              <div
                class="category-image <%= category.colour %>"
                aria-hidden="true"
              ></div>

              <div class="category-caption">
                <span><%= category.name %></span>
                <span class="category-action">
                  Explore <%= category.name.toLowerCase() %> &rarr;
                </span>
              </div>
            </a>
                            <% }); %>
                </div>
            </div>
        </section>

        <section id="collection" class="collection-section">
            <div class="container">
                <p class="eyebrow">A LITTLE LOOK INSIDE</p>
                <h2>New pieces</h2>

                <% if (collectionError) { %>
                    <p>
                        We couldn’t load the pieces right now. Please try again shortly.
                    </p>

                    <% } else if (featuredProducts.length === 0) { %>
                        <p>
                            New handmade pieces are on their way. Check back soon.
                        </p>

                        <% } else { %>
                            <div class="product-grid">
                                <% featuredProducts.forEach((product) => { %>
                                    <article class="product-card">
                                        <% if (isCustomer) { %>
                                            <a class="product-card-link" href="/shop/products/<%= product.id %>">
                                                <% } %>

                                                    <% if (product.image_url) { %>
                                                        <img class="product-image" src="<%= product.image_url %>" alt="<%= product.name %>" loading="lazy" width="400" height="540">
                                                        <% } else { %>
                                                            <div class="product-placeholder">
                                                                <span>Photo coming soon</span>
                                                            </div>
                                                            <% } %>

                                                                <div class="product-caption">
                                                                    <h3>
                                                                        <%= product.name %>
                                                                    </h3>
                                                                    <p class="product-price">
                                                                        <%= formatMoney(product.price) %>
                                                                    </p>
                                                                </div>

                                                                <% if (isCustomer) { %>
                                            </a>
                                            <% } %>
                                    </article>
                                    <% }); %>
                            </div>
                            <% } %>
            </div>
        </section>

        <section class="maker-section" aria-labelledby="maker-title">
            <div class="container maker-inner">
                <div class="maker-image" role="img" aria-label="Maker portrait coming soon"></div>

                <div class="maker-copy">
                    <p class="eyebrow">BEHIND THE STITCHES</p>
                    <h2 id="maker-title">Meet the maker</h2>

                    <p>
                        Behind Ke. MALAPI is a love for handmade crochet. Each piece takes shape one stitch at a time, with care woven into the details.
                    </p>

                    <a class="button button-outline" href="#our-story">
            Our story
          </a>
                </div>
            </div>
        </section>

        <section class="custom-section" aria-labelledby="custom-title">
            <div class="container custom-inner">
                <h2 id="custom-title">
                    Want something made just for you?
                </h2>

                <p>
                    Tell us your size, colour and idea, and we’ll crochet it for you.
                </p>

                <button class="button button-light" type="button" disabled aria-describedby="custom-status">
          Request a custom piece
        </button>

                <p id="custom-status" class="custom-status">
                    Custom requests opening soon.
                </p>
            </div>
        </section>

        <section id="lookbook" class="lookbook-section" aria-labelledby="lookbook-title">
            <div class="container">
                <h2 id="lookbook-title">Lookbook moments</h2>

                <p class="lookbook-note">
                    A little space for the pieces in real life. Photos coming soon.
                </p>

                <div class="lookbook-grid" aria-hidden="true">
                    <div class="lookbook-tile lookbook-tan"></div>
                    <div class="lookbook-tile lookbook-brown"></div>
                    <div class="lookbook-tile lookbook-sand"></div>
                    <div class="lookbook-tile lookbook-sand"></div>
                    <div class="lookbook-tile lookbook-tan"></div>
                    <div class="lookbook-tile lookbook-olive"></div>
                </div>
            </div>
        </section>
    </main>

    <footer class="site-footer" id="contact">
        <div class="container">
            <div class="footer-grid">
                <div class="footer-brand">
                    <a class="brand" href="/" aria-label="Ke. MALAPI home">
                        <img class="brand-logo" src="/images/logo.jpg" alt="Ke. MALAPI">
                    </a>

                    <p>
                        Handmade crochet fashion. Made slowly, worn proudly.
                    </p>
                </div>

                <nav class="footer-column" aria-label="Footer navigation">
                    <h2>Explore</h2>
                    <a href="#collection">New pieces</a>
                    <a href="#lookbook">Lookbook</a>
                    <a href="#our-story">Our story</a>
                </nav>

                <div class="footer-column">
                    <h2>Contact</h2>

                    <a href="tel:+27726551906">+27 72 655 1906</a>

                    <div class="social-links">
                        <a href="https://www.instagram.com/kemalapi.sa/" target="_blank" rel="noopener noreferrer" aria-label="Ke. MALAPI on Instagram (opens in a new tab)">
                            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true" focusable="false">
                            <rect x="3" y="3" width="18" height="18" rx="5"></rect>
                            <circle cx="12" cy="12" r="4"></circle>
                            <circle cx="17.5" cy="6.5" r="1" fill="currentColor" stroke="none"></circle>
                          </svg>
                        </a>

                        <a href="https://www.tiktok.com/@kemalapi.sa" target="_blank" rel="noopener noreferrer" aria-label="Ke. MALAPI on TikTok (opens in a new tab)">
                            <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
                            <path d="M16.7 1h-3.8v15.1a3.2 3.2 0 1 1-2.8-3.2V9.1a7 7 0 1 0 6.6 7V8.4a9.1 9.1 0 0 0 5.3 1.7V6.3A5.4 5.4 0 0 1 16.7 1Z"></path>
                          </svg>
                        </a>
                    </div>
                </div>
            </div>

            <div class="footer-bottom">
                <small>
          &copy; <%= new Date().getFullYear() %> Ke. MALAPI.
          All rights reserved.
        </small>

                <span>Made with care, stitch by stitch.</span>
            </div>
        </div>
    </footer>

    <dialog id="account-dialog" class="account-dialog" aria-labelledby="account-title">
        <div class="account-content">
            <button id="close-account" class="account-close" type="button" aria-label="Close account window">
        &times;
      </button>

            <p class="eyebrow">COME ON IN</p>
            <h2 id="account-title">Welcome back.</h2>

            <p id="account-description" class="auth-description">
                Log in to explore the full collection.
            </p>

            <form id="account-form" class="auth-form">
                <div id="account-name-field" class="form-field" hidden>
                    <label for="account-name">Full name</label>

                    <input id="account-name" name="name" type="text" autocomplete="name" maxlength="150" disabled>
                </div>

                <div class="form-field">
                    <label for="account-email">Email address</label>

                    <input id="account-email" name="email" type="email" autocomplete="username" maxlength="254" required>
                </div>

                <div class="form-field">
                    <label for="account-password">Password</label>

                    <div class="password-field">
                        <input id="account-password" name="password" type="password" autocomplete="current-password" aria-describedby="account-password-help" required>

                        <button id="toggle-password" class="password-toggle" type="button" aria-controls="account-password" aria-pressed="false" aria-label="Show password">
              Show
            </button>
                    </div>

                    <small id="account-password-help" hidden>
            Use at least 12 characters, one uppercase letter
            and one special character.
          </small>
                </div>

                <button id="account-submit" class="button button-dark" type="submit">
          Log in
        </button>
            </form>

            <p id="account-message" class="auth-message" role="status" aria-live="polite"></p>

            <button id="account-switch" class="account-switch" type="button">
        New here? Create an account
      </button>
        </div>
    </dialog>

    <script src="/account-modal.js" defer></script>
</body>

</html>