<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">

    <title>Create an account | Ke. MALAPI</title>

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@300;400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/style.css">
</head>

<body>
    <header class="site-header">
        <div class="container header-inner">
            <a class="brand" href="/" aria-label="Ke. MALAPI home">
                <img class="brand-logo" src="/images/logo.jpg" alt="Ke. MALAPI">
            </a>
            <a class="text-link" href="/">Back to home</a>
        </div>
    </header>

    <main class="auth-page">
        <section class="auth-panel" aria-labelledby="signup-title">
            <p class="eyebrow">COME ON IN</p>
            <h1 id="signup-title">A little more you.</h1>

            <p class="auth-description">
                Create an account to explore the full collection, save pieces in your cart and place your order.
            </p>

            <form class="auth-form" action="/api/customers/signup" method="post">
                <div class="form-field">
                    <label for="name">Full name</label>
                    <input id="name" name="name" type="text" autocomplete="name" maxlength="150" required>
                </div>

                <div class="form-field">
                    <label for="email">Email address</label>
                    <input id="email" name="email" type="email" autocomplete="email" maxlength="254" required>
                </div>

                <div class="form-field">
                    <label for="password">Password</label>
                    <input id="password" name="password" type="password" autocomplete="new-password" minlength="12" pattern="(?=.*[A-Z])(?=.*[^A-Za-z0-9\s]).{12,}" title="Use at least 12 characters, one uppercase letter and one special character." aria-describedby="password-help"
                        required>

                    <small id="password-help">
                    Use at least 12 characters, including an uppercase letter
                    and a special character such as !, @ or #.
                  </small>
                    <small id="password-help">
            Use at least 12 characters.
          </small>
                </div>

                <button class="button button-dark" type="submit">
          Create account
        </button>
            </form>

            <p id="signup-message" class="auth-message" role="status" aria-live="polite"></p>

            <a id="signup-next" class="auth-next" href="/" hidden>
            Back to the shop
          </a>

        </section>
    </main>

    <script src="/signup.js" defer></script>

</body>

</html>